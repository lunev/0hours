{
  "manifest_version": 3,
  "name": "0hours",
  "version": "1.0.0",
  "description": "0h. Feel the hour.",
  "author": {
    "name": "Oleksandr Lunov",
    "email": "lunevdev@gmail.com"
  },
  "permissions": ["storage", "alarms", "offscreen"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "0hours",
    "default_icon": "logo.png"
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
