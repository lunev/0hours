{
  "manifest_version": 3,
  "name": "0hours",
  "version": "1.0.1",
  "description": "Hourly voice time announcements in English and Ukrainian",
  "author": {
    "name": "Oleksandr Lunov",
    "email": "lunevdev@gmail.com"
  },
  "permissions": ["storage", "alarms", "offscreen"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "0hours",
    "default_icon": "icons/logo128x128.png"
  },
  "icons": {
    "16": "icons/logo16x16.png",
    "32": "icons/logo32x32.png",
    "48": "icons/logo48x48.png",
    "128": "icons/logo128x128.png"
  }
}
